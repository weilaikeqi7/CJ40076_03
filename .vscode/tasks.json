{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/arm-none-eabi-gcc.cmake"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "CMake: Build",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "J-Link: Flash",
            "type": "process",
            "command": "JLink.exe",
            "args": [
                "-NoGui",
                "1",
                "-CommandFile",
                "${workspaceFolder}/.vscode/jlink_flash.jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build",
            "problemMatcher": []
        },
        {
            "label": "J-Link: RTT Viewer",
            "type": "process",
            "command": "JLinkRTTViewer.exe",
            "args": [
                "-device",
                "N32G4FRHE",
                "-if",
                "SWD",
                "-speed",
                "4000",
                "-autoconnect",
                "1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
